{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiliDesk",
  "version": "0.1.0",
  "identifier": "com.bilidesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BiliDesk",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "BiliDesk",
    "shortDescription": "非官方哔哩哔哩桌面客户端",
    "longDescription": "个人自用的非官方 Windows 哔哩哔哩客户端。播放组件使用 LGPL 授权的 libmpv。",
    "category": "Video",
    "resources": ["vendor/mpv/libmpv-2.dll", "THIRD_PARTY.md"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
